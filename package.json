{
  "name": "dsh-subagent-codex",
  "version": "0.1.0",
  "description": "DeepSeek Harness subagent provider: run OpenAI Codex CLI as a one-shot coding subagent backend (host plane)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/tool.js",
    "lib/tool.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "subagent",
    "codex",
    "openai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyyxs88/dsh-subagent-codex.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
